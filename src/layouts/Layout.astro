---
import '../styles/global.css';

const { title = '个人网站' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
</head>
<body>
  <nav class="navbar">
    <div class="container">
      <a href="/" class="logo">张克震</a>
      <ul class="nav-links">
        <li><a href="/" class:list={['', currentPath === '/' ? 'active' : '']}>首页</a></li>
        <li><a href="/blog" class:list={['', currentPath.startsWith('/blog') ? 'active' : '']}>博客</a></li>
        <li><a href="/portfolio" class:list={['', currentPath.startsWith('/portfolio') ? 'active' : '']}>作品集</a></li>
      </ul>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer class="footer">
    <div class="container">
      <p>&copy; {new Date().getFullYear()} 张克震. All rights reserved.</p>
    </div>
  </footer>
</body>
</html>
