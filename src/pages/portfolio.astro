---
import Layout from '../layouts/Layout.astro';
import { getPortfolios, getImageUrl } from '../lib/strapi';

const portfolios = await getPortfolios();
---

<Layout title="作品集 - 张克震">
  <section class="page-header container">
    <h1>作品集</h1>
    <p>设计与创作精选</p>
  </section>

  <section class="container">
    {portfolios.length > 0 ? (
      <div class="card-grid">
        {portfolios.map((item) => {
          const cover = item.cover;
          const imgUrl = cover?.length > 0 ? getImageUrl(cover[0]) : '';
          return (
            <a href={`/portfolio/${item.slug}`} class="card">
              {imgUrl && <img src={imgUrl} alt={item.title} class="card-image" loading="lazy" />}
              <div class="card-body">
                <h2>{item.title}</h2>
                <p class="meta">{item.category}{item.publishedAt ? ` · ${new Date(item.publishedAt).toLocaleDateString('zh-CN')}` : ''}</p>
                <p class="excerpt">{item.description}</p>
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <div style="text-align:center;padding:60px 0;color:var(--color-muted);">
        <p>还没有作品，请前往 Strapi 后台创建。</p>
      </div>
    )}
  </section>
</Layout>
